{% extends 'basedeux.html.twig' %}

{% block title %}Nouvelle catégorie{% endblock %}

{% block body %}
<div class="container my-5" style="max-width: 720px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold mb-1">Créer une catégorie</h1>
      <p class="text-muted mb-0">Ajoute une nouvelle catégorie pour tes produits.</p>
    </div>

    <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary rounded-3">
      ← Retour
    </a>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
      {{ include('category/_form.html.twig', {'button_label': 'Créer'}) }}
    </div>
  </div>

</div>
{% endblock %}
