{% extends 'base.html.twig' %}
{% block body %}

<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">

{# ===== HERO ===== #}
<section class="hero-bg d-flex align-items-center text-center text-white">
  <div class="container position-relative">
    <h1 class="display-5 fw-bold mb-3">Une mode pudique, moderne.</h1>
    <p class="lead mb-4">Des pièces sobres, pensées pour durer.</p>
  </div>
</section>

{# ===== COLLECTION ===== #}
<div class="container my-5">
  <div class="text-center mb-4">
    <h1 class="cabin-font mb-1">Collection</h1>
    <p class="text-muted mb-0">Découvre nos pièces sélectionnées.</p>
  </div>

  <div class="row g-4">
    {% for produit in produit %}
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card product-card h-100 border-0 shadow-sm rounded-4 position-relative">

          <div class="product-img-wrap">
            <img
              src="{{ produit.photo ? asset('images/' ~ produit.photo) : asset('images/default.png') }}"
              class="product-img"
              alt="{{ produit.nom }}"
              loading="lazy"
            >
          </div>

          <div class="card-body">
            <h6 class="product-title">{{ produit.nom }}</h6>

            <p class="product-desc text-muted">
              {{ produit.descrptionlong }}
            </p>

            <div class="d-flex justify-content-between align-items-center">
              <div class="product-price">{{ produit.prix }} €</div>
              <span class="product-cta">Découvrir →</span>
            </div>

            <a href="{{ path('app_produit_show_detaille', { id: produit.id }) }}"
               class="stretched-link"
               aria-label="Voir le produit {{ produit.nom }}"></a>
          </div>

        </div>
      </div>
    {% endfor %}
  </div>

  <div class="mt-5 text-center">
    <h3 class="signature">
      La pudeur comme choix, l’élégance comme signature
    </h3>
  </div>
</div>

{# ===== FOOTER ===== #}
<footer class="site-footer mt-5 pt-5 pb-4">
  <div class="container">
    <div class="row g-4">

      <div class="col-12 col-md-4">
        <h5 class="footer-title mb-3">VotreMarque</h5>
        <p class="footer-text mb-3">
          Une mode pudique, moderne. Des pièces sobres, pensées pour durer.
        </p>
      </div>

      <div class="col-6 col-md-2">
        <h6 class="footer-title-sm mb-3">Boutique</h6>
        <ul class="list-unstyled footer-links">
          <li><a href="#">Collection</a></li>
          <li><a href="#">Nouveautés</a></li>
          <li><a href="#">Meilleures ventes</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-2">
        <h6 class="footer-title-sm mb-3">Aide</h6>
        <ul class="list-unstyled footer-links">
          <li><a href="#">Livraison</a></li>
          <li><a href="#">Retours</a></li>
          <li><a href="#">FAQ</a></li>
        </ul>
      </div>
    </div>

    <hr class="footer-hr my-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <small class="footer-muted">© {{ "now"|date("Y") }} VotreMarque.</small>
    </div>
  </div>
</footer>

{# ===== STYLE ===== #}
<style>
/* HERO */
.hero-bg{
  min-height: 90vh;
  background-image: url("/images/hero.png");
  background-size: cover;
  background-position: center;
  position: relative;
}
.hero-bg::before{
  content:"";
  position:absolute;
  inset:0;
  background: rgba(0,0,0,.55);
}
.hero-bg .container{ position: relative; z-index: 1; }

/* ===== CARDS ===== */
.product-card{
  transition: transform .18s ease, box-shadow .18s ease;
}
.product-card:hover{
  transform: translateY(-3px);
  box-shadow: 0 16px 34px rgba(0,0,0,.12) !important;
}

/* IMAGE PLUS COURTE */
.product-img-wrap{
  aspect-ratio: 1 / 1; /* carré = cards plus compactes */
  background:#f4f4f4;
  overflow:hidden;
}
.product-img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition: transform .25s ease;
}
.product-card:hover .product-img{
  transform: scale(1.04);
}

/* TEXTE */
.card-body{
  padding: .75rem !important;
}
.product-title{
  font-weight:700;
  line-height:1.2;
  margin-bottom: .25rem;
}

/* Description limitée */
.product-desc{
  font-size: .9rem;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: .75rem;
}

.product-price{
  font-weight:800;
  font-size:1rem;
}
.product-cta{
  font-weight:700;
  font-size:.9rem;
  opacity:.8;
  transition: opacity .18s ease, transform .18s ease;
}
.product-card:hover .product-cta{
  opacity:1;
  transform: translateX(2px);
}

/* TITRES */
.cabin-font{
  font-family: "Raleway", sans-serif;
  font-weight: 700;
}
.signature{
  font-weight: 700;
}

/* FOOTER */
.site-footer{
  background: #0f0f10;
  color: rgba(255,255,255,.85);
  font-family: "Cabin", sans-serif;
}
.footer-links a{
  color: rgba(255,255,255,.75);
  text-decoration: none;
}
.footer-links a:hover{
  color:#fff;
}
.footer-hr{ border-color: rgba(255,255,255,.12); }
.footer-muted{ color: rgba(255,255,255,.6); }
</style>

{% endblock %}
