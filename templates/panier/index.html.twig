{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">Mon panier</h1>
  </div>

  {% if items is empty %}
    <div class="alert alert-light border">
      Votre panier est vide.
    </div>
  {% else %}

    {# ================= DESKTOP / TABLETTE : TABLE ================= #}
    <div class="card border-0 shadow-sm rounded-4 d-none d-md-block">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Produit</th>
              <th>Prix</th>
              <th class="text-center">Quantité</th>
              <th>Sous-total</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for item in items %}
              <tr>
                <td class="fw-semibold">
                  {{ item.produit.nom }}
                  <div class="text-muted small">Taille : {{ item.variant.taille }}</div>
                </td>

                <td>{{ item.produit.prix }} €</td>

                <td class="text-center">
                  <div class="d-inline-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-dark"
                       href="{{ path('app_panier_moins', {'id': item.variant.id}) }}">-</a>

                    <span class="fw-bold">{{ item.quantite }}</span>

                    <a class="btn btn-sm btn-dark"
                       href="{{ path('app_panier_plus', {'id': item.variant.id}) }}">+</a>
                  </div>
                </td>

                <td class="fw-bold">{{ item.sousTotal|number_format(2, '.', ' ') }} €</td>

                <td class="text-end">
                  <a class="btn btn-sm btn-outline-danger"
                     href="{{ path('app_panier_supprimer', {'id': item.variant.id}) }}">
                    Supprimer
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# ================= MOBILE : CARDS ================= #}
    <div class="d-md-none">
      {% for item in items %}
        <div class="card border-0 shadow-sm rounded-4 mb-3">
          <div class="card-body p-3">

            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="fw-semibold">{{ item.produit.nom }}</div>
                <div class="text-muted small mt-1">{{ item.produit.prix }} € / unité</div>
                <div class="text-muted small">Taille : {{ item.variant.taille }}</div>
              </div>

              <a class="btn btn-sm btn-outline-danger"
                 href="{{ path('app_panier_supprimer', {'id': item.variant.id}) }}">
                Supprimer
              </a>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="qty">
                <a class="btn btn-sm btn-outline-dark"
                   href="{{ path('app_panier_moins', {'id': item.variant.id}) }}">-</a>

                <span class="fw-bold px-2">{{ item.quantite }}</span>

                <a class="btn btn-sm btn-dark"
                   href="{{ path('app_panier_plus', {'id': item.variant.id}) }}">+</a>
              </div>

              <div class="text-end">
                <div class="text-muted small">Sous-total</div>
                <div class="fw-bold">{{ item.sousTotal|number_format(2, '.', ' ') }} €</div>
              </div>
            </div>

          </div>
        </div>
      {% endfor %}
    </div>

    {# ================= TOTAL + ACTIONS ================= #}
    <div class="summary mt-4">
      <a class="btn btn-outline-danger rounded-3 w-100 w-md-auto"
         href="{{ path('app_panier_vider') }}">
        Vider le panier
      </a>

      <div class="total-box mt-3 mt-md-0 text-md-end">
        <div class="text-muted">Total</div>
        <div class="fs-4 fw-bold">{{ total|number_format(2, '.', ' ') }} €</div>

        <button class="btn btn-dark rounded-3 mt-2 w-100 w-md-auto" type="button" disabled>
          Commander (à faire)
        </button>
      </div>
    </div>

  {% endif %}
</div>

<style>
/* Résumé responsive */
.summary{
  display:flex;
  flex-direction:column;
  gap: 12px;
}

/* Desktop */
@media (min-width: 768px){
  .summary{
    flex-direction:row;
    justify-content:space-between;
    align-items:flex-start;
  }
  .total-box{
    min-width: 260px;
  }
}
</style>
{% endblock %}
