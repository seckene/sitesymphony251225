{% extends 'basedeux.html.twig' %}

{% block body %}
<div class="container my-5">

  <div class="page-head mb-4">
    <div>
      <div class="page-kicker">Produit</div>
      <h1 class="page-title mb-0">{{ produit.nom }}</h1>
    </div>

    <div class="page-actions">
      <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary btn-sm rounded-3">
        ← Retour
      </a>
      <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-dark btn-sm rounded-3">
        Modifier
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">

      <div class="row g-4 align-items-start">
        {# ===== MEDIA ===== #}
        <div class="col-12 col-md-5">
          {% set cover = produit.photo ? asset('images/' ~ produit.photo) : asset('images/default.png') %}

          <div class="media-wrap">
            <img class="media-main" src="{{ cover }}" alt="{{ produit.nom }}">
          </div>

          {% if produit.produitImages|length > 0 %}
            <div class="thumbs">
              {% for img in produit.produitImages %}
                <img class="thumb" src="{{ asset('images/' ~ img.filename) }}" alt="">
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {# ===== INFOS ===== #}
        <div class="col-12 col-md-7">
          <div class="info-box">
            <div class="info-title">Détails</div>

            <table class="table table-borderless mb-0 info-table">
              <tbody>
                <tr>
                  <th class="label w-25">ID</th>
                  <td class="value">{{ produit.id }}</td>
                </tr>

                <tr>
                  <th class="label">Nom</th>
                  <td class="value fw-semibold">{{ produit.nom }}</td>
                </tr>

                <tr>
                  <th class="label">Description</th>
                  <td class="value">{{ produit.descrptionlong }}</td>
                </tr>

                <tr>
                  <th class="label">Prix</th>
                  <td class="value price">{{ produit.prix }} €</td>
                </tr>
              </tbody>
            </table>

            <div class="danger-zone mt-4">
              {{ include('produit/_delete_form.html.twig') }}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
/* ===== Header ===== */
.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap: 14px;
}
.page-kicker{
  font-size: .85rem;
  color: rgba(0,0,0,.55);
}
.page-title{
  font-weight: 750;
  letter-spacing: .2px;
}

/* ===== Actions ===== */
.page-actions{
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
}

/* ===== Media ===== */
.media-wrap{
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,.08);
  background: #f6f6f6;
}
.media-main{
  width: 100%;
  height: 360px;
  object-fit: cover;
  display: block;
}

/* Thumbnails */
.thumbs{
  display:flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}
.thumb{
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,.10);
  background: #fff;
}

/* ===== Info box ===== */
.info-box{
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 16px;
  padding: 16px;
}
.info-title{
  font-weight: 700;
  margin-bottom: 12px;
}
.info-table tr{
  border-bottom: 1px solid rgba(0,0,0,.06);
}
.info-table tr:last-child{
  border-bottom: 0;
}
.label{
  color: rgba(0,0,0,.55);
  font-weight: 600;
  font-size: .92rem;
  padding: 10px 8px !important;
  vertical-align: top;
}
.value{
  color: rgba(0,0,0,.85);
  padding: 10px 8px !important;
  line-height: 1.6;
}
.price{
  font-weight: 800;
  font-size: 1.05rem;
}

/* Delete area */
.danger-zone{
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,.08);
}

/* ===== Responsive ===== */
@media (max-width: 768px){
  .page-head{
    flex-direction: column;
    align-items: flex-start;
  }
  .media-main{ height: 320px; }
  .info-box{ padding: 14px; }
}
</style>
{% endblock %}
