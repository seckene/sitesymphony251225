{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">
  <div class="row g-5 align-items-start">

    {# ================= MEDIA / CAROUSEL ================= #}
    <div class="col-12 col-lg-6">
      <div id="productCarousel{{ produit.id }}" class="carousel slide media" data-bs-ride="carousel" data-bs-touch="true">
        <div class="carousel-inner">

          {% set cover = produit.photo ? 'images/' ~ produit.photo : 'images/default.png' %}
          <div class="carousel-item active">
            <div class="media-frame">
              <img src="{{ asset(cover) }}" alt="{{ produit.nom }}" loading="lazy">
            </div>
          </div>

          {% for img in produit.produitImages %}
            <div class="carousel-item">
              <div class="media-frame">
                <img src="{{ asset('images/' ~ img.filename) }}" alt="{{ produit.nom }}" loading="lazy">
              </div>
            </div>
          {% endfor %}

        </div>

        {% if produit.produitImages|length > 0 %}
          <button class="carousel-control-prev carousel-btn" type="button"
                  data-bs-target="#productCarousel{{ produit.id }}" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Précédent</span>
          </button>

          <button class="carousel-control-next carousel-btn" type="button"
                  data-bs-target="#productCarousel{{ produit.id }}" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Suivant</span>
          </button>
        {% endif %}
      </div>
    </div>

    {# ================= INFOS ================= #}
    <div class="col-12 col-lg-6">
      <div class="info">

        <div class="meta">
          {% if produit.category is defined and produit.category %}
            <a class="cat" href="#">{{ produit.category.nom }}</a>
          {% endif %}
        </div>

        <h1 class="title">{{ produit.nom }}</h1>
        <div class="price">{{ produit.prix }} €</div>

        <div class="divider"></div>

        <p class="desc">{{ produit.descrptionlong }}</p>

        {# ===== Détails produit (simple & propre) ===== #}
        <div class="details">
          <div class="details-title">Détails</div>

          <div class="details-grid">
            <div class="k">Matière</div>
            <div class="v">{{ produit.matiere ?? '—' }}</div>

            <div class="k">Coupe</div>
            <div class="v">{{ produit.coupe ?? '—' }}</div>

            <div class="k">Longueur</div>
            <div class="v">{{ produit.longueur ?? '—' }}</div>

            <div class="k">Entretien</div>
            <div class="v">{{ produit.entretien ?? '—' }}</div>
          </div>
        </div>

        {# ===== CTA ===== #}
        <form action="{{ path('app_panier_ajouter') }}" method="post">
  <select name="variant_id" class="form-select mb-3" required>
    <option value="" disabled selected>Choisir une taille</option>

    {% for v in produit.variants %}
      <option value="{{ v.id }}" {% if v.stock == 0 %}disabled{% endif %}>
        {{ v.taille }} {% if v.stock == 0 %}(Rupture){% else %}({{ v.stock }} dispo){% endif %}
      </option>
    {% endfor %}
  </select>

  <button type="submit" class="btn btn-dark w-100">Ajouter au panier</button>
</form>

    </div>

  </div>
</div>

<style>
/* ===== Carousel (plein, sans bandes) ===== */
.media{
  border-radius: 18px;
  overflow: hidden;
  background: #fff;
  height: 560px;
}
.media .carousel-inner,
.media .carousel-item,
.media .media-frame{
  height: 100%;
}
.media-frame{
  position: relative;
  width: 100%;
  background: #fff;
}
.media-frame img{
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* controls discrets */
.carousel-btn{ width: 12%; opacity: 0; transition: opacity .15s ease; }
.media:hover .carousel-btn{ opacity: .85; }
.carousel-control-prev-icon,
.carousel-control-next-icon{
  background-size: 55% 55%;
  filter: drop-shadow(0 6px 14px rgba(0,0,0,.25));
}

/* ===== Infos ===== */
.info{ padding-top: 2px; }

.meta{ margin-bottom: .35rem; }
.cat{
  font-size: .9rem;
  text-decoration: none;
  color: rgba(0,0,0,.55);
}
.cat:hover{ color: rgba(0,0,0,.9); }

.title{
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 .35rem 0;
  line-height: 1.15;
}
.price{
  font-size: 1.1rem;
  font-weight: 600;
  color: rgba(0,0,0,.65);
  margin-bottom: 1.1rem;
}
.divider{
  height: 1px;
  background: rgba(0,0,0,.10);
  margin: 1.2rem 0;
}
.desc{
  font-size: 1rem;
  line-height: 1.75;
  color: rgba(0,0,0,.68);
  margin: 0 0 1.2rem 0;
  max-width: 58ch;
}

/* ===== Détails ===== */
.details{
  border-top: 1px solid rgba(0,0,0,.08);
  padding-top: 1.1rem;
  margin-top: .4rem;
}
.details-title{
  font-weight: 600;
  margin-bottom: .8rem;
}
.details-grid{
  display: grid;
  grid-template-columns: 140px 1fr;
  row-gap: .55rem;
  column-gap: 1rem;
  font-size: .98rem;
}
.k{ color: rgba(0,0,0,.55); }
.v{ color: rgba(0,0,0,.82); }

/* ===== CTA ===== */
.actions{ margin-top: 1.4rem; max-width: 420px; }
.btn-main{
  width: 100%;
  padding: .95rem 1rem;
  border-radius: 14px;
  border: 1px solid rgba(0,0,0,.12);
  background: #111;
  color: #fff;
  font-weight: 600;
}
.btn-main:hover{ opacity: .92; }

.trust{
  margin-top: .9rem;
  color: rgba(0,0,0,.60);
  font-size: .95rem;
  display: grid;
  gap: .35rem;
}

/* back */
.back{
  display:inline-block;
  margin-top: 1.3rem;
  text-decoration: none;
  font-weight: 600;
  color: rgba(0,0,0,.55);
}
.back:hover{ color: rgba(0,0,0,.9); }

/* responsive */
@media (max-width: 992px){
  .media{ height: 420px; }
  .desc{ max-width: none; }
  .actions{ max-width: none; }
  .carousel-btn{ opacity: .9; }
  .details-grid{ grid-template-columns: 120px 1fr; }
}
</style>
{% endblock %}
